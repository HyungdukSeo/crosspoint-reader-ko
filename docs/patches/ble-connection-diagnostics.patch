+// Deleting a saved device while the radio is OFF must not initialize NimBLE.
+// Record only explicit user deletions; apply them once the stack is available.
+// Never clear a peer's security keys as part of an ordinary connection attempt.
+struct ForgottenPeer {
+  char addr[18];
+  uint8_t type;
+};
+
+uint8_t readForgottenPeers(Preferences& p, ForgottenPeer* peers) {
+  if (!p.isKey("forget")) return 0;
+  const size_t bytes = p.getBytesLength("forget");
+  if (bytes == 0 || bytes > sizeof(ForgottenPeer) * BleKeyboardHost::kMaxBonds || bytes % sizeof(ForgottenPeer)) {
+    return 0;
+  }
+  if (p.getBytes("forget", peers, bytes) != bytes) return 0;
+  const uint8_t count = bytes / sizeof(ForgottenPeer);
+  for (uint8_t i = 0; i < count; ++i) peers[i].addr[17] = '\0';
+  return count;
+}
+
+bool queueForgottenPeer(const PairedHidDevice& peer) {
+  Preferences p;
+  if (!p.begin("freeink-hid", false)) return false;
+  ForgottenPeer peers[BleKeyboardHost::kMaxBonds]{};
+  uint8_t count = readForgottenPeers(p, peers);
+  for (uint8_t i = 0; i < count; ++i) {
+    if (strcmp(peers[i].addr, peer.addr) == 0 && peers[i].type == peer.addrType) return true;
+  }
+  if (count == BleKeyboardHost::kMaxBonds) return false;
+  strncpy(peers[count].addr, peer.addr, sizeof(peers[count].addr) - 1);
+  peers[count++].type = peer.addrType;
+  const size_t bytes = count * sizeof(ForgottenPeer);
+  return p.putBytes("forget", peers, bytes) == bytes;
+}
+
+void applyForgottenPeers() {
+  Preferences p;
+  if (!p.begin("freeink-hid", false)) return;
+  ForgottenPeer peers[BleKeyboardHost::kMaxBonds]{};
+  const uint8_t count = readForgottenPeers(p, peers);
+  uint8_t remaining = 0;
+  for (uint8_t i = 0; i < count; ++i) {
+    const NimBLEAddress addr(std::string(peers[i].addr), peers[i].type);
+    // Preserve transient failures, but an already absent bond is complete too.
+    // Checking the result also handles identity mapping for a private address.
+    const int result = ble_gap_unpair(addr.getBase());
+    if (result != 0 && result != BLE_HS_ENOENT) peers[remaining++] = peers[i];
+  }
+  if (remaining) p.putBytes("forget", peers, remaining * sizeof(ForgottenPeer));
+  else if (count) p.remove("forget");
+}
+
